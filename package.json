{
  "name": "network-server-suite",
  "private": true,
  "version": "2.4.1",
  "type": "module",
  "bin": "dist/server.cjs",
  "pkg": {
    "assets": [
      "dist/**/*"
    ]
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:exe": "npm run build && pkg . --targets node18-win-x64 --icon assets/icon.ico --output network_server_suite.exe",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js applet_state.json served_folder",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^4.21.2",
    "ftp-srv": "^4.6.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ssh2": "^1.16.0",
    "telnet-client": "^2.2.5",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ssh2": "^1.15.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pkg": "^5.8.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
